# /etc/acca-usa/monitor.env  (root:acca, mode 0640 — NOT in Git). Placeholders only.
HEALTH_URL=http://127.0.0.1:3000/api/health?ready=1
CERT_HOST=your-domain.example
BACKUP_DIR=/var/backups/acca-usa
DISK_PATHS="/ /srv/minio-data"
DISK_WARN_PERCENT=85
# Where alerts go (any of them; all optional — without them alerts are only written to the journal):
# ALERT_TELEGRAM_TOKEN=      # token of a Telegram bot created with @BotFather
# ALERT_TELEGRAM_CHAT=       # your chat id (message the bot, then open https://api.telegram.org/bot<token>/getUpdates)
# ALERT_WEBHOOK_URL=         # any URL accepting POST {"text": "..."}
