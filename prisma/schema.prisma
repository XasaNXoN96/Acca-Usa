// ACCA USA — PostgreSQL schema.
//
// Conventions
//  • Identifiers that appear in URLs are stable strings owned by the application (platform slug, subject slug,
//    topic / test / material ids); everything else uses cuid().
//  • Enum members are lower-case where the application already uses lower-case values (locale, status, kinds), so
//    service code maps rows 1:1 without translation tables.
//  • Soft delete (`deletedAt`) for users and content; per-user learning state cascades with the user.
//  • Payments, certificates and attempts are records of fact: they RESTRICT deletes and keep snapshots
//    (holder name, review) so later edits never rewrite history.
//  • No business logic in the schema. Derived numbers (progress, ranking, statistics) are computed from these rows.
//
// Auth: the application uses its own signed-cookie session layer (src/lib/auth), not Auth.js, so there are no
// Account / Session tables. Reset tokens and the rate-limit store live here instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── enums ─────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  active
  suspended
}

enum Locale {
  en
  ru
  uz
}

enum MaterialKind {
  video
  pdf
  notes
  audio
  slides
  image
  file
  book
}

enum Difficulty {
  easy
  medium
  hard
}

enum QuestionStatus {
  draft
  published
}

enum ReviewPolicy {
  IMMEDIATE
  AFTER_CLOSE
  NEVER
}

enum TestKind {
  topic_test
  exam
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum EnrollmentStatus {
  FREE
  ACTIVE
  EXPIRED
  REVOKED
}

enum EnrollmentSource {
  self
  payment
  admin
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CertificateStatus {
  issued
  revoked
}

enum CertificateSource {
  auto
  admin
}

enum ActivityKind {
  topic
  test
  enroll
}

// ───────────────────────────── identity ─────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique // stored lower-case
  passwordHash String? // scrypt "s1$salt$hash"; null = no password yet (use reset). Never leaves the server.
  role         Role       @default(STUDENT)
  status       UserStatus @default(active)
  locale       Locale     @default(en)
  /// bumped on password reset / suspension / role change → revokes every older session cookie
  tokenVersion Int        @default(0)
  /// TOTP secret, AES-256-GCM encrypted (lib/auth/mfa-crypto). While mfaEnabledAt is null it is an enrolment still being confirmed.
  mfaSecretEnc String?
  mfaEnabledAt DateTime?
  /// last accepted 30-second TOTP step — a code from this step or earlier can never be replayed
  mfaLastStep  Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  enrollments      Enrollment[]
  topicProgress    TopicProgress[]
  materialProgress MaterialProgress[]
  lastMaterial     LastMaterial?
  materialViews    MaterialView[]
  materialNotes    MaterialNote[]
  practiceAnswers  PracticeAnswer[]
  attempts         TestAttempt[]
  payments         Payment[]
  certificates     Certificate[]
  notifications    Notification[]
  activity         Activity[]
  resetTokens      ResetToken[]
  mfaRecoveryCodes MfaRecoveryCode[]

  @@index([role, status])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  /// HMAC-SHA-256 of the normalised code — the clear code is shown once, at enrolment
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

model ResetToken {
  /// SHA-256 of the random token — the raw token is only ever in the e-mail / reset link.
  tokenHash String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window rate limiter shared by every instance (login, register, reset, webhooks).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ───────────────────────────── catalogue ─────────────────────────────

model Platform {
  slug       String    @id // acca | fia
  name       String
  fullName   String
  /// Price of full access in the smallest currency unit (USD cents). 0 = free enrolment (no payment involved).
  priceCents Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  levels       Level[]
  enrollments  Enrollment[]
  payments     Payment[]
  certificates Certificate[]
}

model Level {
  id           String @id // e.g. acca-l1
  platformSlug String
  order        Int
  name         String

  platform Platform  @relation(fields: [platformSlug], references: [slug], onDelete: Restrict)
  subjects Subject[]

  @@unique([platformSlug, order])
}

model Subject {
  slug      String    @id
  code      String
  name      String
  levelId   String
  /// display order inside the level (admin-created subjects are appended)
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  level        Level         @relation(fields: [levelId], references: [id], onDelete: Restrict)
  topics       Topic[]
  materials    Material[]
  questions    Question[]
  tests        Test[]
  certificates Certificate[]

  @@index([levelId])
}

model Topic {
  id              String    @id
  subjectSlug     String
  order           Int
  title           String
  description     String    @default("") @db.Text
  keyPoints       String[]
  lessonCount     Int       @default(0)
  durationMinutes Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  subject   Subject         @relation(fields: [subjectSlug], references: [slug], onDelete: Restrict)
  materials Material[]
  questions Question[]
  tests     Test[]
  progress  TopicProgress[]

  @@index([subjectSlug, order])
}

model Material {
  id          String       @id
  subjectSlug String
  topicId     String?
  kind        MaterialKind
  title       String
  /// Storage object id (owned by the StorageProvider, not an FK: the demo provider keeps files on disk); null for notes
  fileId      String?
  fileMime    String?
  body        String?      @db.Text // kind = notes: plain text, never rendered as HTML
  /// false = draft (students never see it). Existing rows stay published.
  published   Boolean      @default(true)
  /// published AND publishAt in the future = scheduled: becomes visible to students at that time
  publishAt   DateTime?
  /// order inside the topic (lower first, ties by creation time)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  subject  Subject            @relation(fields: [subjectSlug], references: [slug], onDelete: Restrict)
  topic    Topic?             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  progress   MaterialProgress[]
  transcript Transcript?
  subtitles  Subtitle[]
  versions   MaterialVersion[]
  views      MaterialView[]
  notes      MaterialNote[]

  @@index([subjectSlug])
  @@index([topicId])
  @@index([fileId])
}

/// One answer given while practising a past mistake ("Practice your mistakes"). Ungraded: it never changes a test result,
/// only whether the question still counts as an unresolved mistake. questionId is a plain reference (questions are soft-deleted).
model PracticeAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  correct    Boolean
  at         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, questionId, at])
}

/// A student's private note on a material, optionally anchored to a PDF page or a video / audio time. Only its owner
/// can read or change it (every query is scoped by userId); there is no administrator read path.
model MaterialNote {
  id           String   @id @default(cuid())
  userId       String
  materialId   String
  body         String   @db.Text
  pdfPage      Int?
  videoSeconds Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([userId, materialId, createdAt])
  @@index([userId, updatedAt])
}

/// One student opening a material (at most one per student and material per 30 minutes). Real events only.
model MaterialView {
  id         String   @id @default(cuid())
  materialId String
  userId     String
  at         DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([materialId, at])
  @@index([userId, materialId, at])
}

/// A PREVIOUS state of a material (file / text), kept when the file is replaced so it can be restored. The current
/// state always lives on Material. Version files stay in storage (attached) and are readable by staff only.
model MaterialVersion {
  id          String       @id @default(cuid())
  materialId  String
  kind        MaterialKind
  title       String
  fileId      String?
  fileMime    String?
  body        String?      @db.Text
  createdAt   DateTime     @default(now())
  createdById String?

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, createdAt])
}

enum TranscriptStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

/// One transcript per video / audio material. `segments` = [{start,end,text}] (seconds). provider = "manual" or the
/// SpeechToTextProvider that produced it; nothing is ever generated without a connected provider.
model Transcript {
  id         String           @id @default(cuid())
  materialId String           @unique
  language   String
  status     TranscriptStatus @default(QUEUED)
  provider   String
  segments   Json             @default("[]")
  errorCode  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

/// Subtitle track (WebVTT file in storage) of a material, one per language (en / ru / uz).
model Subtitle {
  id         String   @id @default(cuid())
  materialId String
  language   String
  /// StoredFile id of the .vtt
  fileId     String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, language])
}

/// Metadata of an object kept by the production StorageProvider. Bytes never live in PostgreSQL. Referenced by
/// Material.fileId / Question.imageId by id only (no FK) so every storage provider can own its own metadata.
model StoredFile {
  id              String     @id
  storageKey      String     @unique // key inside the bucket / folder
  name            String // sanitised original name
  mime            String // derived from the validated extension, never from the client
  size            Int
  ownerId         String
  attached        Boolean    @default(false)
  /// media metadata (video / audio duration, thumbnail key, …) — see docs/MEDIA.md
  durationSeconds Int?
  thumbnailKey    String?
  /// Processing state. Rows that existed before the media pipeline were validated at upload and are served: READY.
  status          FileStatus @default(READY)
  /// Machine code of the last failure / rejection (e.g. FFMPEG_NOT_AVAILABLE, PROBE_FAILED); never a stack trace
  statusCode      String?
  attempts        Int        @default(0)
  processedAt     DateTime?
  /// ffprobe results (null until processed)
  container       String?
  videoCodec      String?
  audioCodec      String?
  width           Int?
  height          Int?
  /// StoredFile id of the browser-playable rendition (H.264/AAC MP4, AAC M4A) produced by FFmpeg; null = the file itself plays
  playbackFileId  String?
  /// StoredFile id of the poster frame (JPEG) of a video
  thumbnailFileId String?
  createdAt       DateTime   @default(now())

  @@index([attached, createdAt])
  @@index([status])
}

enum FileStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  REJECTED
}

// ───────────────────────────── access ─────────────────────────────

model Enrollment {
  id           String           @id @default(cuid())
  userId       String
  platformSlug String
  status       EnrollmentStatus @default(ACTIVE)
  source       EnrollmentSource @default(self)
  paymentId    String?
  /// null = does not expire
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformSlug], references: [slug], onDelete: Restrict)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([userId, platformSlug])
  @@index([platformSlug, status])
}

// ───────────────────────────── learning state ─────────────────────────────

model TopicProgress {
  userId    String
  topicId   String
  /// "started" (10) or "completed" (100); partial progress is derived from materials + tests
  percent   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
}

model MaterialProgress {
  userId      String
  materialId  String
  completedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
  @@index([materialId])
  @@index([completedAt])
}

model LastMaterial {
  userId     String   @id
  materialId String
  at         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id      String       @id @default(cuid())
  userId  String
  kind    ActivityKind
  title   String
  context String
  href    String
  detail  String?
  at      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at(sort: Desc)])
}

// ───────────────────────────── assessment ─────────────────────────────

model Question {
  id              String         @id
  subjectSlug     String
  topicId         String?
  text            String         @db.Text
  /// [{ "id": "a", "text": "…" }, … ] — four options; the answer key is `correctOptionId` and stays on the server
  options         Json
  correctOptionId String
  explanation     String         @db.Text
  points          Int            @default(1)
  difficulty      Difficulty     @default(medium)
  tags            String[]
  imageId         String?
  status          QuestionStatus @default(draft)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  subject Subject        @relation(fields: [subjectSlug], references: [slug], onDelete: Restrict)
  topic   Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  tests   TestQuestion[]

  @@index([subjectSlug, status])
  @@index([topicId])
}

model Test {
  id                 String    @id
  subjectSlug        String
  topicId            String?
  kind               TestKind  @default(topic_test)
  title              String
  description        String    @default("") @db.Text
  durationMinutes    Int
  passMark           Int
  /// 0 = unlimited
  attemptsAllowed    Int       @default(0)
  randomizeQuestions Boolean   @default(false)
  randomizeAnswers   Boolean   @default(false)
  published          Boolean   @default(false)
  publishedAt        DateTime?
  /// exams only: optional availability window
  opensAt            DateTime?
  closesAt           DateTime?
  /// exams only: when a student may see the question-by-question review of a finished attempt
  reviewPolicy       ReviewPolicy @default(IMMEDIATE)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  subject   Subject        @relation(fields: [subjectSlug], references: [slug], onDelete: Restrict)
  topic     Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questions TestQuestion[]
  attempts  TestAttempt[]

  @@index([subjectSlug, published])
  @@index([topicId])
  @@index([kind, published])
}

model TestQuestion {
  testId     String
  questionId String
  position   Int

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([testId, questionId])
  @@index([testId, position])
  @@index([questionId])
}

/// One attempt. IN_PROGRESS rows hold the autosaved draft; SUBMITTED rows hold the frozen result snapshot.
model TestAttempt {
  id               String        @id @default(cuid())
  testId           String
  userId           String
  status           AttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime      @default(now())
  /// server-authoritative: startedAt + duration. The client timer is only a display.
  deadlineAt       DateTime
  submittedAt      DateTime?
  /// { [questionId]: optionId }
  answers          Json          @default("{}")
  flagged          Json          @default("[]")
  currentIndex     Int           @default(0)
  // ── result (set on submit) ──
  scorePercent     Int?
  passed           Boolean?
  timeSpentSeconds Int?
  /// frozen TestResult (questions, answers, explanations) so later edits never rewrite history
  result           Json?
  updatedAt        DateTime      @updatedAt

  test Test @relation(fields: [testId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, testId, status])
  @@index([testId, submittedAt])
  @@index([userId, submittedAt])
}

// ───────────────────────────── commerce ─────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  userId            String
  platformSlug      String
  description       String
  amountCents       Int
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  provider          String
  /// provider's own id (checkout session / charge); unique per provider
  providerPaymentId String?
  /// provider-hosted checkout page (kept so a retried request returns the same checkout)
  checkoutUrl       String?
  /// client-supplied idempotency key for payment creation
  idempotencyKey    String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  platform    Platform       @relation(fields: [platformSlug], references: [slug], onDelete: Restrict)
  enrollments Enrollment[]
  events      PaymentEvent[]

  @@unique([provider, providerPaymentId])
  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([status, createdAt])
}

/// Every webhook delivery, keyed by the provider's event id → replays are detected and ignored (idempotency).
model PaymentEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  paymentId  String?
  type       String
  receivedAt DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
}

model Certificate {
  id           String            @id @default(cuid())
  /// AU-<year>-<6 digits>; also the public verification identifier
  number       String            @unique
  userId       String
  platformSlug String
  subjectSlug  String
  /// snapshots at issue time
  studentName  String
  subjectCode  String
  subjectName  String
  title        String
  status       CertificateStatus @default(issued)
  source       CertificateSource @default(auto)
  issuedAt     DateTime          @default(now())
  revokedAt    DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  platform Platform @relation(fields: [platformSlug], references: [slug], onDelete: Restrict)
  subject  Subject  @relation(fields: [subjectSlug], references: [slug], onDelete: Restrict)

  @@index([userId, subjectSlug])
  @@index([status, issuedAt])
}

model CertificateCounter {
  year Int @id
  last Int @default(0)
}

// ───────────────────────────── engagement ─────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// NotificationCode (translated at render time — no prose is stored)
  code      String
  params    Json?
  /// NotificationTarget as JSON: { kind, … }
  target    Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}
