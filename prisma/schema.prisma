// ACCA USA — database schema (PREPARED, not yet connected).
// Next stage: `npx prisma migrate dev`, then replace services/mock/* with Prisma-backed services.
// Conventions: cuid ids, UTC timestamps, soft delete via `deletedAt`, no business logic in the schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Locale {
  EN
  RU
  UZ
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MaterialKind {
  VIDEO
  PDF
  NOTES
  AUDIO
  SLIDES
  BOOK
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum ExamStatus {
  SCHEDULED
  OPEN
  COMPLETED
}

// ---------- Identity (Auth.js compatible) ----------

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // only for credentials sign-in; never exposed to the client
  role          Role       @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  locale        Locale     @default(EN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  enrollments   Enrollment[]
  progress      TopicProgress[]
  attempts      TestAttempt[]
  payments      Payment[]
  certificates  Certificate[]
  notifications Notification[]
  examResults   ExamResult[]

  @@index([role, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Catalogue ----------

model Platform {
  id        String    @id @default(cuid())
  slug      String    @unique // acca | fia
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  levels       Level[]
  enrollments  Enrollment[]
  exams        Exam[]
  certificates Certificate[]
  translations PlatformTranslation[]
}

model PlatformTranslation {
  platformId String
  locale     Locale
  name       String
  fullName   String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([platformId, locale])
}

model Level {
  id         String    @id @default(cuid())
  platformId String
  order      Int
  name       String
  deletedAt  DateTime?

  platform Platform  @relation(fields: [platformId], references: [id])
  subjects Subject[]

  @@unique([platformId, order])
}

model Subject {
  id        String    @id @default(cuid())
  slug      String    @unique
  code      String
  levelId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  level        Level                @relation(fields: [levelId], references: [id])
  topics       Topic[]
  tests        Test[]
  materials    Material[]
  exams        Exam[]
  translations SubjectTranslation[]

  @@index([levelId])
}

model SubjectTranslation {
  subjectId String
  locale    Locale
  name      String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([subjectId, locale])
}

model Topic {
  id        String    @id @default(cuid())
  slug      String    @unique
  subjectId String
  order     Int
  lessonCount     Int @default(0)
  durationMinutes Int @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subject      Subject            @relation(fields: [subjectId], references: [id])
  materials    Material[]
  tests        Test[]
  progress     TopicProgress[]
  translations TopicTranslation[]

  @@unique([subjectId, order])
}

model TopicTranslation {
  topicId     String
  locale      Locale
  title       String
  description String   @db.Text
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([topicId, locale])
}

model Material {
  id         String       @id @default(cuid())
  subjectId  String
  topicId    String?
  kind       MaterialKind
  title      String
  storageKey String? // object-storage key; files are served via signed URLs
  meta       String?
  createdAt  DateTime     @default(now())
  deletedAt  DateTime?

  subject Subject @relation(fields: [subjectId], references: [id])
  topic   Topic?  @relation(fields: [topicId], references: [id])

  @@index([subjectId, topicId])
}

// ---------- Learning state ----------

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  platformId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([userId, platformId])
}

model TopicProgress {
  userId      String
  topicId     String
  percent     Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
}

// ---------- Assessment ----------

model Question {
  id            String    @id @default(cuid())
  text          String    @db.Text
  explanation   String    @db.Text
  correctOption String // option id; never sent to the client before submission
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  options Option[]
  tests   TestQuestion[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  order      Int
  text       String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
}

model Test {
  id              String    @id @default(cuid())
  slug            String    @unique
  subjectId       String
  topicId         String?
  title           String
  durationMinutes Int
  passMark        Int
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  subject   Subject        @relation(fields: [subjectId], references: [id])
  topic     Topic?         @relation(fields: [topicId], references: [id])
  questions TestQuestion[]
  attempts  TestAttempt[]
}

model TestQuestion {
  testId     String
  questionId String
  order      Int

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([testId, questionId])
  @@unique([testId, order])
}

/// Autosave target: IN_PROGRESS attempts hold the draft (answers/flags/position) on the server.
model TestAttempt {
  id             String        @id @default(cuid())
  testId         String
  userId         String
  status         AttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime      @default(now())
  deadlineAt     DateTime // server-authoritative: startedAt + duration
  submittedAt    DateTime?
  answers        Json // { [questionId]: optionId }
  flagged        Json // string[]
  currentIndex   Int           @default(0)
  elapsedSeconds Int           @default(0)
  scorePercent   Int?
  updatedAt      DateTime      @updatedAt

  test Test @relation(fields: [testId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, testId, status])
}

model Exam {
  id              String     @id @default(cuid())
  title           String
  platformId      String
  subjectId       String
  startsAt        DateTime
  durationMinutes Int
  status          ExamStatus @default(SCHEDULED)
  createdAt       DateTime   @default(now())
  deletedAt       DateTime?

  platform Platform     @relation(fields: [platformId], references: [id])
  subject  Subject      @relation(fields: [subjectId], references: [id])
  results  ExamResult[]
}

model ExamResult {
  examId       String
  userId       String
  scorePercent Int
  createdAt    DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([examId, userId])
}

// ---------- Commerce & engagement ----------

model Payment {
  id          String        @id @default(cuid())
  userId      String
  description String
  amountCents Int
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?       @unique
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Certificate {
  id         String    @id @default(cuid())
  userId     String
  platformId String
  title      String
  issuedAt   DateTime?
  createdAt  DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  platform Platform @relation(fields: [platformId], references: [id])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  title      String
  body       String
  targetKind String // topic | test | result | exam | certificate | payment | none
  targetId   String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
