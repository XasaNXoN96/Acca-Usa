{
  "name": "acca-usa",
  "version": "0.1.0",
  "private": true,
  "description": "ACCA USA — online learning platform for ACCA and FIA students.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/check-admin-i18n.mjs && node scripts/check-i18n-quality.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:brand",
    "db:validate": "DATABASE_URL=postgresql://user:pass@localhost:5432/db prisma validate",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "smoke": "node scripts/smoke.mjs",
    "smoke:all": "node scripts/run-smokes.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "smoke:db": "DATA_PROVIDER=prisma node scripts/run-smokes.mjs",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:storage": "node --conditions=react-server --import tsx scripts/integration/storage-s3.ts",
    "test:media": "tsx scripts/integration/media-info.ts",
    "test:media-pipeline": "NEXT_PUBLIC_APP_MODE=demo node -r ./scripts/integration/stub-server-only.cjs --import tsx scripts/integration/media-pipeline.ts",
    "test:notes": "NEXT_PUBLIC_APP_MODE=demo node -r ./scripts/integration/stub-server-only.cjs --import tsx scripts/integration/notes.ts",
    "test:media-text": "NEXT_PUBLIC_APP_MODE=demo DATA_PROVIDER=memory node -r ./scripts/integration/stub-server-only.cjs --import tsx scripts/integration/media-text.ts",
    "media:worker": "node -r ./scripts/integration/stub-server-only.cjs --import tsx scripts/media-worker.ts",
    "test:pdf": "node --conditions=react-server --import tsx scripts/integration/certificate-pdf.ts",
    "test:email": "node -r ./scripts/integration/stub-server-only.cjs --import tsx scripts/integration/email.ts",
    "test:payments": "node -r ./scripts/integration/stub-server-only.cjs --import tsx scripts/integration/payments.ts",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "build:prod-test": "NEXT_PUBLIC_APP_MODE=production NEXT_DIST_DIR=.next-prod next build",
    "test:production": "node scripts/test-production-mode.mjs",
    "test:env": "tsx scripts/integration/env-check.ts",
    "test:integration": "npm run test:env && npm run test:media && npm run test:media-pipeline && npm run test:media-text && npm run test:pdf && npm run test:email && npm run test:payments && npm run test:storage",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:pg-restart": "node scripts/test-pg-restart.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/lib-storage": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.0.16",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
