# Application mode. `demo` (default) runs standalone on demo data + the demo storage provider.
# `production` requires the real providers (database, storage, payments) from the backend block
# and currently refuses to start. This value is public by design (NEXT_PUBLIC_).
NEXT_PUBLIC_APP_MODE=demo

# --- Server-only secrets. NEVER prefix with NEXT_PUBLIC_. ---
# Session signing secret (>= 32 chars). Optional in demo mode (a random one is generated in the OS temp dir);
# REQUIRED in production mode.  Generate: openssl rand -base64 48
AUTH_SECRET=

# Backend block (not used yet)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acca_usa?schema=public"
AUTH_URL="http://localhost:3000"
