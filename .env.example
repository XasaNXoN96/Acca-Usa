# ──────────────────────────────────────────────────────────────────────────────
# ACCA USA environment. Copy to .env.local (never commit real values).
# Server-only: nothing below may be prefixed NEXT_PUBLIC_ (except the mode itself).
# Full reference: docs/ENVIRONMENT_VARIABLES.md (VPS: docs/VPS_DEPLOYMENT.md; secrets live in /etc/acca-usa/acca-usa.env, never in Git)
# ──────────────────────────────────────────────────────────────────────────────

# demo (default): standalone demo data, simulated payments, no real e-mail.
# production: every variable in the "production" block is REQUIRED and validated at startup.
# Compiled into the bundle — build and run with the same value.
NEXT_PUBLIC_APP_MODE=demo

# memory (default in demo) | prisma (required in production)
DATA_PROVIDER=memory

# PostgreSQL (needed when DATA_PROVIDER=prisma; migrations: npm run db:migrate, demo data: npm run db:seed)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acca_usa?schema=public"

# Session signing secret, >= 32 chars. Required in production. Generate: openssl rand -base64 48
AUTH_SECRET=

# Administrators must use two-step verification (TOTP). Always on in production mode; set 1 to enforce it in demo/staging too.
# MFA_REQUIRED=1

# Optional separate key for the audit hash chain (>= 32 chars). Set it to the current AUTH_SECRET BEFORE rotating AUTH_SECRET. See docs/AUDIT.md.
# AUDIT_CHAIN_SECRET=

# ── production block ──────────────────────────────────────────────────────────
# Public https URL of the site (links in e-mails, payment return URLs, certificate QR codes)
APP_URL=

# Private S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, …)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=1

# SMTP for transactional e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ACCA USA <no-reply@your-domain>"
# SMTP_SECURE=1

# Payments (Stripe Checkout) — secret key and the signing secret of the /api/webhooks/payments endpoint
# Stripe secret key: sk_test_… (test mode) or sk_live_… (live). The mode is shown in Admin → Payments.
# Online payments are an explicit choice in production (the server refuses to start without it):
#   none    online payments OFF — no Stripe variables needed; paid platforms show a contact notice (LEGAL_CONTACT_EMAIL);
#           access is granted by an administrator (Admin → Access). Use this for the first launch.
#   stripe  Stripe Checkout + signed webhooks — requires the two variables below.
#   payme   Payme (Uzbek sum) — PAYME_MERCHANT_ID + PAYME_KEY, PRICE_CURRENCY=UZS.
# PAYMENTS_PROVIDER=payme   Payme (Uzbekistan, needs PRICE_CURRENCY=UZS + the variables below; docs/PAYMENTS.md)
PAYMENTS_PROVIDER=
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# TEST ONLY: redirect the Stripe REST API to a local test double (refused together with a live key)
# STRIPE_API_BASE=http://127.0.0.1:12111/v1

# ── antivirus (docs/ANTIVIRUS.md): REQUIRED choice in production — clamav (every upload scanned by clamd before it is served) or none
ANTIVIRUS_PROVIDER=
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=/run/clamav/clamd.ctl
# CLAMAV_TIMEOUT_MS=120000

# ── Telegram bot: notifications + administrator second factor + support (docs/TELEGRAM.md). All five are needed together.
# TELEGRAM_BOT_TOKEN=            # from @BotFather (a password!)
# TELEGRAM_BOT_USERNAME=         # the bot's username without @
# TELEGRAM_WEBHOOK_SECRET=       # random 24+ characters you invent: openssl rand -hex 20
# TELEGRAM_CHAT_ID=              # your chat id: press Start in the bot, it answers with the number
# SUPPORT_TELEGRAM=mirzaxojayevas  # contact shown on /support (without @)
# TELEGRAM_EVENTS=system,security,users,payments,content,support
# TELEGRAM_PII=masked            # masked | full (whole e-mail addresses in messages)

# ── media processing (docs/MEDIA.md). With the media-worker service running, set MEDIA_INLINE_PROCESSING=0.
# MEDIA_INLINE_PROCESSING=0
# MEDIA_CONCURRENCY=1
# MEDIA_POLL_SECONDS=15
# MEDIA_TMP_DIR=/var/lib/acca-media
# MEDIA_MIN_FREE_MB=128
# MEDIA_TRANSCODE_TIMEOUT_MS=1800000
# MEDIA_STALE_MINUTES=

# Let search engines index the PUBLIC pages (robots.txt + sitemap.xml). Leave unset on staging / demo. Student and admin areas are never listed.
# SEO_INDEX=1

# Currency of all prices and payments: USD (default) or UZS (Uzbek sum). Prices are typed in whole units (150000 = 150 000 sum).
# Stripe cannot charge UZS — the server refuses PAYMENTS_PROVIDER=stripe together with PRICE_CURRENCY=UZS.
# PRICE_CURRENCY=UZS

# ── backup / restore (operator commands, not read by the web app) — see docs/BACKUP_AND_RESTORE.md
# BACKUP_DIR=/secure/backups
# BACKUP_PASSPHRASE=        # >= 16 chars; encrypts backups at rest
# BACKUP_KEEP=14
# BACKUP_REMOTE=            # rclone destination for an off-server copy of the dumps (deploy/backup/backup.sh)
# FILES_SOURCE_REMOTE=      # rclone remote of the primary bucket …
# FILES_REPLICA_REMOTE=     # … copied into this second bucket

# ── legal pages (docs/LEGAL.md). The first three are REQUIRED in production; texts show a draft notice until LEGAL_TEXTS_REVIEWED=1.
# LEGAL_OPERATOR_NAME=
# LEGAL_CONTACT_EMAIL=
# LEGAL_DATA_LOCATION=            # where the database / files / backups really are (country, provider)
# LEGAL_OPERATOR_ADDRESS=
# LEGAL_OPERATOR_TAX_ID=
# LEGAL_GOVERNING_LAW=
# LEGAL_REFUND_WINDOW=            # e.g. "14 days from payment"
# LEGAL_TEXTS_REVIEWED=1          # set only after a lawyer reviewed the texts for your jurisdiction
